{
	"singleQuote": false,
	"tabWidth": 4,
	"semi": true,
	"printWidth": 90,
	"trailingComma": "none",
	"endOfLine": "lf",
	"plugins": ["@trivago/prettier-plugin-sort-imports"],
	"validImports": ["@stylexjs/stylex", "stylex"],
	"importOrder": [
		"<THIRD_PARTY_MODULES>",
		"^app/(.*)$",
		"^lib/(.*)$",
		"^state/(.*)$",
		"^tests/(.*)$",
		"^types/(.*)$",
		"^view/(.*)$",
		"^[./](.*)$"
	],
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true,
	"importOrderGroupNamespaceSpecifiers": true
}
